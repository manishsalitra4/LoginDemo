<h1>Submitted usernames</h1>
<p>Latest <%= @submissions.length %> submissions.</p>
<table style="width:100%;border-collapse:collapse;font-size:14px">
<thead><tr><th style="text-align:left;padding:10px;border-bottom:1px solid #ddd">Username 1</th><th style="text-align:left;padding:10px;border-bottom:1px solid #ddd">Username 2</th><th style="text-align:left;padding:10px;border-bottom:1px solid #ddd">Submitted</th></tr></thead>
<tbody><% @submissions.each do |s| %><tr>
<td style="padding:10px;border-bottom:1px solid #eee"><%= s.username1 %></td>
<td style="padding:10px;border-bottom:1px solid #eee"><%= s.username2 %></td>
<td style="padding:10px;border-bottom:1px solid #eee"><%= s.created_at.strftime("%d %b %Y, %I:%M %p UTC") %></td>
</tr><% end %></tbody></table>
